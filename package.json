{
  "name": "finora",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=24.13.0 <27"
  },
  "scripts": {
    "dev:api": "pnpm --filter @finora/api dev",
    "dev:mobile": "pnpm --filter @finora/mobile start",
    "db:local": "tsx scripts/local-database.ts",
    "typecheck": "tsc -p tsconfig.tools.json && pnpm -r typecheck",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm format:check",
    "build:api": "pnpm --filter @finora/api build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.13.0",
    "mongodb-memory-server": "11.3.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  }
}
