# Copy server values to apps/api/.env.local. Never commit the populated file.
MONGODB_URI=mongodb://127.0.0.1:27017/?replicaSet=finora-local
MONGODB_DB=finora_development
APP_URL=http://localhost:3000
EMAIL_TRANSPORT=local
# Use resend in production with a verified sender domain:
# For hosted testing with recovery intentionally unavailable, use disabled.
RESEND_API_KEY=
EMAIL_FROM=
# Required in production; trust forwarded IP only behind a proxy that overwrites it.
TRUST_PROXY=false
RATE_LIMIT_SECRET=generate-at-least-32-random-characters-for-your-environment
# Optional read-only AI chat. These values are server-only; never EXPO_PUBLIC_.
# Keep disabled until the API key, provider controls and privacy/release checks are ready.
ASSISTANT_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# Copy this public value to apps/mobile/.env.local. Local emulator alternative: http://10.0.2.2:3000
EXPO_PUBLIC_API_URL=https://finora-api-olive.vercel.app
