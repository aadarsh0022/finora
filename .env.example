# Copy server values to apps/api/.env.local. Never commit the populated file.
MONGODB_URI=mongodb://127.0.0.1:27017/?replicaSet=finora-local
MONGODB_DB=finora_development
APP_URL=http://localhost:3000
EMAIL_TRANSPORT=local
# Use resend in production with a verified sender domain:
RESEND_API_KEY=
EMAIL_FROM=
# Required in production; trust forwarded IP only behind a proxy that overwrites it.
TRUST_PROXY=false
RATE_LIMIT_SECRET=generate-at-least-32-random-characters-for-your-environment
# Copy this public value to apps/mobile/.env.local. Emulator -> host machine.
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000
